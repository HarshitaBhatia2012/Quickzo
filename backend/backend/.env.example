# Quickzo MySQL Database Configuration
# Copy this file to .env or set these environment variables in your terminal/system

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickzo
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Alternatively, you can use the standard Spring Boot environment variables:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quickzo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password
