# Quickzo MySQL Database Configuration
# Copy this file to .env or configure these environment variables in your environment / CI/CD

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickzo
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Alternative standard Spring Boot properties format:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quickzo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password
