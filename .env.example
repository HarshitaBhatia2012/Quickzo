# =============================================================================
# Quickzo Docker & MySQL Configuration Environment Variables (.env.example)
# Duplicate this file to '.env' and customize credentials before running containers.
# The '.env' file is strictly excluded by .gitignore and must never be committed.
# =============================================================================

# Database Configuration
# In Docker Compose, the backend connects using the service name 'mysql'
DB_HOST=mysql
DB_PORT=3306
DB_NAME=quickzo
DB_USERNAME=quickzo_user
DB_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Port Bindings (Host:Container)
# Note: 3307 is used on the host to avoid conflicting if you have a local MySQL on 3306
DB_EXTERNAL_PORT=3307
BACKEND_PORT=8081
FRONTEND_PORT=80
